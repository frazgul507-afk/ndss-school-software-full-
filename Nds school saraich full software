import { useState, useEffect } from 'react'; import { Card, CardContent } from '@/components/ui/card'; import { Button } from '@/components/ui/button'; import { Input } from '@/components/ui/input';

export default function App(){ const [logged,setLogged]=useState(false); const [pass,setPass]=useState(''); const [students,setStudents]=useState(()=>JSON.parse(localStorage.getItem('ndss_students')||'[]')); const [dark,setDark]=useState(false); const [tab,setTab]=useState('dashboard'); const [search,setSearch]=useState(''); const [form,setForm]=useState({name:'',father:'',mobile:'',className:'',fee:'',paid:''});

useEffect(()=>{localStorage.setItem('ndss_students',JSON.stringify(students));},[students]);

const totalStudents=students.length; const totalFee=students.reduce((a,b)=>a+(Number(b.fee)||0),0); const totalPaid=students.reduce((a,b)=>a+(Number(b.paid)||0),0); const balance=totalFee-totalPaid;

function login(){if(pass==='admin4436507')setLogged(true);else alert('Wrong Password');} function addStudent(){if(!form.name)return;setStudents([...students,form]);setForm({name:'',father:'',mobile:'',className:'',fee:'',paid:''});setTab('students');} function del(i){const x=[...students];x.splice(i,1);setStudents(x);}

if(!logged)return <div className='p-6 max-w-md mx-auto space-y-4'><h1 className='text-2xl font-bold'>NDSS Login</h1><Input type='password' placeholder='Enter Password' value={pass} onChange={e=>setPass(e.target.value)}/><Button onClick={login} className='w-full'>Login</Button></div>

return <div className={dark ? 'p-4 max-w-6xl mx-auto space-y-4 bg-slate-900 text-white min-h-screen' : 'p-4 max-w-6xl mx-auto space-y-4'}>

<div className='flex items-center gap-3'><img src='https://placehold.co/80x80?text=NDSS' className='rounded-2xl'/><h1 className='text-3xl font-bold'>National Discipline Secondary School Saraich</h1></div>
<div className='grid grid-cols-2 md:grid-cols-6 gap-2'>
<Button onClick={()=>setTab('dashboard')}>Dashboard</Button><Button onClick={()=>setDark(!dark)}>{dark ? 'Light' : 'Dark'} Mode</Button>
<Button onClick={()=>setTab('add')}>Add Student</Button>
<Button onClick={()=>setTab('students')}>Students</Button>
<Button onClick={()=>setTab('fees')}>Fees</Button>
<Button onClick={()=>setTab('reports')}>Reports</Button>
<Button onClick={()=>setTab('attendance')}>Attendance</Button>
<Button onClick={()=>setTab('results')}>Results</Button>
</div>{tab==='dashboard' && <div className='grid md:grid-cols-4 gap-4'> <Card><CardContent className='p-4'><div>Total Students</div><div className='text-2xl font-bold'>{totalStudents}</div></CardContent></Card> <Card><CardContent className='p-4'><div>Total Monthly Fee</div><div className='text-2xl font-bold'>{totalFee}</div></CardContent></Card> <Card><CardContent className='p-4'><div>Total Paid</div><div className='text-2xl font-bold'>{totalPaid}</div></CardContent></Card> <Card><CardContent className='p-4'><div>Balance</div><div className='text-2xl font-bold'>{balance}</div></CardContent></Card><Card><CardContent className='p-4'><div>Year Income</div><div className='text-2xl font-bold'>{totalPaid*12}</div></CardContent></Card>

</div>}{tab==='add' && <Card><CardContent className='p-4 space-y-2'> <Input placeholder='Student Name' value={form.name} onChange={e=>setForm({...form,name:e.target.value})}/> <Input placeholder='Father Name' value={form.father} onChange={e=>setForm({...form,father:e.target.value})}/> <Input placeholder='Mobile Number' value={form.mobile} onChange={e=>setForm({...form,mobile:e.target.value})}/> <Input placeholder='Class' value={form.className} onChange={e=>setForm({...form,className:e.target.value})}/> <Input placeholder='Monthly Fee' value={form.fee} onChange={e=>setForm({...form,fee:e.target.value})}/> <Input placeholder='Paid Fee' value={form.paid} onChange={e=>setForm({...form,paid:e.target.value})}/> <Button onClick={addStudent}>Save Student</Button> </CardContent></Card>}

{tab==='students' && <div className='space-y-2'><Input placeholder='Search Student' value={search} onChange={e=>setSearch(e.target.value)} />{students.filter(s=>s.name.toLowerCase().includes(search.toLowerCase())).map((s,i)=><Card key={i}><CardContent className='p-4'><div className='font-bold'>{s.name}</div><div>{s.father} | {s.className}</div><div>Fee {s.fee} Paid {s.paid}</div><div>Balance {Number(s.fee||0)-Number(s.paid||0)}</div><div className='flex gap-2 mt-2'><Button onClick={()=>window.print()}>Receipt</Button><Button onClick={()=>alert('Edit feature next update')}>Edit</Button><Button onClick={()=>del(i)}>Delete</Button></div></CardContent></Card>)}</div>}

{tab==='fees' && <Card><CardContent className='p-4'>Manage fees, receipts, balances.</CardContent></Card>} {tab==='attendance' && <Card><CardContent className='p-4'>Mark Present / Absent and monthly attendance report.</CardContent></Card>} {tab==='results' && <Card><CardContent className='p-4'>Enter 1st Term / 2nd Term / 3rd Term marks and print result card.</CardContent></Card>} {tab==='reports' && <Card><CardContent className='p-4'>Attendance system, results cards, search, edit, receipts now included in next build stage.</CardContent></Card>}

</div>
}
